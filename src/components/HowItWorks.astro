---
import Visual from './Visual.astro';
import { t, type Lang } from '../i18n/ui';
import buildSvg from '../illustrations/dome-build.svg?raw';
import panelA from '../illustrations/panel-a.svg?raw';
import panelB from '../illustrations/panel-b.svg?raw';
import frameA from '../illustrations/frame-a.svg?raw';
import frameB from '../illustrations/frame-b.svg?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).how;
const dec = (n: number) => (lang === 'pt' ? n.toFixed(2).replace('.', ',') : n.toFixed(2));
// Side lengths for the D'OME 6 (sphere radius 3.05 m): chord factors 0.4124, 0.4035, 0.3486.
const panels = [
  { label: c.panelA, svg: panelA, count: 75, sides: [1.26, 1.26, 1.23] },
  { label: c.panelB, svg: panelB, count: 30, sides: [1.06, 1.06, 1.23] },
];
// The structure: one timber triangle per face, same two shapes as the panels that cover them.
const frames = [
  { label: c.frameA, svg: frameA, count: 75 },
  { label: c.frameB, svg: frameB, count: 30 },
];
const rows = [
  { label: c.framesLabel, items: frames },
  { label: c.panelsLabel, items: panels },
];
---

<section class="section how" id="como-funciona">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
    </div>

    <div class="how-grid">
      <ol class="steps">
        {
          c.steps.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="how-side">
        <div class="how-visual">
          <Visual name="montagem" alt={c.buildAlt} illustration={buildSvg} />
        </div>
        <div class="panels">
          <div class="panels-copy">
            <h3>{c.panelsTitle}</h3>
            <p>{c.panelsText}</p>
          </div>
          {
            rows.map((row) => (
              <div class="panel-row">
                <p class="panel-row-label">{row.label}</p>
                <ul class="panel-list">
                  {row.items.map((p) => (
                    <li>
                      <div class="panel-shape" set:html={p.svg} />
                      <p class="panel-count">
                        <strong>{p.count}×</strong> {p.label}
                      </p>
                      {'sides' in p && <p class="panel-sides">{p.sides.map(dec).join(' · ')} m</p>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <p class="panels-note">{c.panelsNote}</p>
        </div>
        <Visual name="kit" alt={c.kitAlt} class="how-kit" />
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--white);
  }
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 36px;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .num {
    width: 56px;
    height: 50px;
    display: grid;
    place-items: start center;
    padding-top: 7px;
    background: var(--ink);
    color: var(--paper);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    font-weight: 800;
    font-stretch: 115%;
    font-size: 1.15rem;
    line-height: 1;
  }
  .steps h3 {
    margin-bottom: 6px;
  }
  .steps p {
    color: var(--muted);
  }
  .how-side {
    display: grid;
    gap: 20px;
  }
  .how-visual {
    background: var(--paper);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .how-visual :global(.visual--illustration) {
    width: 86%;
    margin: 4% auto 0;
  }
  .how-visual :global(.visual--photo) {
    aspect-ratio: 4 / 3;
  }
  .panels {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: grid;
    gap: 18px;
  }
  .panel-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px 28px;
    align-items: center;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }
  .panel-row-label {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .panels-copy {
    display: grid;
    gap: 6px;
  }
  .panels-copy p {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
  }
  .panel-list li {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }
  .panel-shape {
    width: 92px;
  }
  .panel-shape :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .panel-count {
    font-size: 0.95rem;
    color: var(--ink);
  }
  .panel-count strong {
    font-stretch: 115%;
  }
  .panel-sides {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .panels-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .how-side :global(.how-kit) {
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
  }
  @media (max-width: 900px) {
    .how-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .panel-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel-list {
      justify-content: space-around;
    }
  }
</style>
