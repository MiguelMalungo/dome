---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).faq;
---

<section class="section faq" id="perguntas">
  <div class="wrap faq-grid">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
    </div>
    <div class="items">
      {
        c.items.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                <path d="M4 7l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Answers slide open and closed instead of jumping (skipped with reduced motion).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
      const summary = d.querySelector('summary')!;
      let anim: Animation | null = null;
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        anim?.cancel();
        const start = d.offsetHeight;
        const opening = !d.open;
        if (opening) d.open = true;
        const end = opening ? d.scrollHeight : summary.offsetHeight;
        d.style.overflow = 'hidden';
        anim = d.animate({ height: [`${start}px`, `${end}px`] }, { duration: opening ? 320 : 240, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' });
        anim.onfinish = () => {
          if (!opening) d.open = false;
          d.style.overflow = '';
          anim = null;
        };
      });
    });
  }
</script>

<style>
  .faq {
    background: var(--white);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }
  .items {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 16px 0;
    cursor: pointer;
    font-weight: 700;
    font-stretch: 106%;
    font-size: 1.08rem;
    color: var(--ink);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex: none;
    transition: transform 0.2s;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  details p {
    padding: 0 40px 22px 0;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq-grid .section-head {
      margin-bottom: 0;
    }
  }
</style>
