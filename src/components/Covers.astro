---
import Visual from './Visual.astro';
import { t, type Lang } from '../i18n/ui';
import osb from '../illustrations/dome-osb.svg?raw';
import fabric from '../illustrations/dome-fabric.svg?raw';
import glass from '../illustrations/dome-glass.svg?raw';
import cork from '../illustrations/dome-cork.svg?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).covers;
const art: Record<string, string> = { osb, fabric, glass, cork };
---

<section class="section covers" id="revestimentos">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <ul class="cover-list">
      {
        c.items.map((item) => (
          <li class="cover">
            <div class="cover-visual">
              <Visual name={`cover-${item.id}`} alt={item.alt} illustration={art[item.id]} sizes="(min-width: 900px) 280px, (min-width: 600px) 45vw, 100vw" />
            </div>
            <div class="cover-body">
              <p class="cover-sub">{item.sub}</p>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <ul class="tags">
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mix">{c.mix}</p>
  </div>
</section>

<style>
  .covers {
    background: var(--paper-2);
  }
  .cover-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cover-visual {
    min-height: 100%;
    background: var(--paper);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .cover-visual :global(.visual--illustration) {
    width: 96%;
  }
  .cover-visual :global(.visual--photo) {
    width: 100%;
    height: 100%;
  }
  .cover-body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 26px 28px;
  }
  .cover-sub {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .cover h3 {
    font-size: 1.6rem;
    font-stretch: 115%;
  }
  .cover-body > p:not(.cover-sub) {
    color: var(--muted);
  }
  .tags {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }
  .mix {
    margin-top: 28px;
    max-width: 44rem;
    color: var(--text);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .cover-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover-visual {
      aspect-ratio: 1 / 0.8;
    }
  }
</style>
