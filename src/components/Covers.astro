---
import Visual from './Visual.astro';
import { t, type Lang } from '../i18n/ui';
import osb from '../illustrations/dome-osb.svg?raw';
import fabric from '../illustrations/dome-fabric.svg?raw';
import glass from '../illustrations/dome-glass.svg?raw';
import cork from '../illustrations/dome-cork.svg?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const c = all.covers;
const art: Record<string, string> = { osb, fabric, glass, cork };
---

<section class="section covers" id="revestimentos" data-covers>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <div class="covers-layout">
      <div class="cover-stage" aria-hidden="true">
        <canvas class="cover-canvas"></canvas>
        <p class="cover-hint">{all.hero.drag}</p>
      </div>

      <ul class="cover-list">
        {
          c.items.map((item) => (
            <li class="cover" data-cover={item.id}>
              <div class="cover-visual">
                <Visual name={`cover-${item.id}`} alt={item.alt} illustration={art[item.id]} sizes="(min-width: 900px) 280px, (min-width: 600px) 45vw, 100vw" />
              </div>
              <div class="cover-body">
                <p class="cover-sub">{item.sub}</p>
                <h3>
                  <button type="button" class="cover-pick" data-cover={item.id} aria-pressed="false">
                    {item.name}
                  </button>
                </h3>
                <p>{item.text}</p>
                <ul class="tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="mix">
      <p>{c.mix}</p>
      <button type="button" class="btn btn--ghost mix-pick" data-cover="mix" aria-pressed="false" hidden>{c.mixButton}</button>
    </div>
  </div>
</section>

<script>
  import { initCoversStage } from '../scripts/covers-stage';
  initCoversStage();
</script>

<style>
  .covers {
    background: var(--paper-2);
  }
  .cover-stage {
    display: none;
  }
  .cover-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cover-visual {
    min-height: 100%;
    background: var(--paper);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .cover-visual :global(.visual--illustration) {
    width: 96%;
  }
  .cover-visual :global(.visual--photo) {
    width: 100%;
    height: 100%;
  }
  .cover-body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 26px 28px;
  }
  .cover-sub {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .cover h3 {
    font-size: 1.6rem;
    font-stretch: 115%;
  }
  /* Without the 3D stage the name is plain heading text. */
  .cover-pick {
    all: unset;
  }
  .cover-body > p:not(.cover-sub) {
    color: var(--muted);
  }
  .tags {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }
  .mix {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .mix p {
    max-width: 44rem;
    color: var(--text);
    font-weight: 500;
  }

  /* Live: the 3D dome beside the four covers; choosing one re-skins the same structure. */
  .covers:global(.is-live) .covers-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }
  .covers:global(.is-live) .cover-stage {
    display: block;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    aspect-ratio: 1 / 1.02;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 50% 58%, rgba(212, 154, 42, 0.2), rgba(212, 154, 42, 0) 70%),
      radial-gradient(120% 90% at 50% 100%, #1e3d34 0%, #142a22 60%, #0e1e18 100%);
  }
  .cover-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .covers:global(.is-ready) .cover-canvas {
    opacity: 1;
  }
  .cover-canvas:global(.is-dragging) {
    cursor: grabbing;
  }
  .cover-hint {
    position: absolute;
    left: 20px;
    bottom: 16px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #d4ddd8;
    pointer-events: none;
  }
  .covers:global(.is-live) .cover-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .covers:global(.is-live) .cover {
    grid-template-columns: 104px minmax(0, 1fr);
    background: transparent;
    border: 1.5px solid var(--line);
    cursor: pointer;
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .covers:global(.is-live) .cover:hover {
    background: color-mix(in srgb, var(--white) 60%, transparent);
  }
  .covers:global(.is-live) .cover:global(.is-active) {
    background: var(--white);
    border-color: var(--accent);
  }
  .covers:global(.is-live) .cover-visual {
    min-height: 0;
    height: 100%;
  }
  .covers:global(.is-live) .cover-body {
    gap: 6px;
    padding: 16px 20px 18px;
  }
  .covers:global(.is-live) .cover h3 {
    font-size: 1.3rem;
  }
  .covers:global(.is-live) .cover-pick {
    cursor: pointer;
  }
  .covers:global(.is-live) .cover-pick:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .covers:global(.is-live) .cover-body > p:not(.cover-sub) {
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .covers:global(.is-live) .tags {
    display: none;
  }
  .mix-pick[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .cover-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .covers:global(.is-live) .covers-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .covers:global(.is-live) .cover-stage {
      position: relative;
      top: auto;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 600px) {
    .cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover-visual {
      aspect-ratio: 1 / 0.8;
    }
    .covers:global(.is-live) .cover {
      grid-template-columns: 84px minmax(0, 1fr);
    }
    .covers:global(.is-live) .cover-visual {
      aspect-ratio: auto;
    }
  }
</style>
